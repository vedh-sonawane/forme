# ─────────────────────────────────────────────────────────────
# FORME environment configuration
# Copy this file to `.env` and fill in values.
# ─────────────────────────────────────────────────────────────

# Database (SQLite for local dev — Prisma). Postgres-compatible schema.
DATABASE_URL="file:./dev.db"

# AI provider. Options: "gemini" | "mock"
# "mock" runs the app with clearly-marked deterministic fake AI (no key needed).
# "gemini" uses the real Google Gemini API (free tier).
AI_PROVIDER="gemini"

# Google Gemini API key — FREE from https://aistudio.google.com/apikey
# If empty, the app automatically falls back to the "mock" provider.
GEMINI_API_KEY=""

# Model selection (free-tier friendly defaults).
# Most powerful vision+reasoning model that is usable on the FREE tier.
# NOTE: gemini-2.5-pro is quota-blocked on the free tier (429), so we default to
# gemini-2.5-flash which has strong vision + reasoning and a workable free quota.
GEMINI_MODEL_PRO="gemini-2.5-flash"
# Lightweight passes (requirements/system/plan). Keep on a free-available model.
GEMINI_MODEL_FLASH="gemini-2.5-flash"

# Where uploaded screenshots + generated sites + captures are stored on disk.
STORAGE_DIR="./storage"

# Public base URL of this app (used for absolute preview links).
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Set to "1" to skip Playwright at runtime (URL analysis will degrade gracefully).
DISABLE_PLAYWRIGHT="0"
