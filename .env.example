# ─────────────────────────────────────────────────────────────
# FORME environment configuration
# Copy this file to `.env` and fill in values.
# ─────────────────────────────────────────────────────────────

# Database (SQLite for local dev — Prisma). Postgres-compatible schema.
DATABASE_URL="file:./dev.db"

# AI provider. Options: "openrouter" | "gemini" | "mock"
# "openrouter" = one API over many FREE models; auto-cascades to another model when one
#   is busy/rate-limited (recommended — avoids single-provider daily-quota stalls).
# "gemini" = Google Gemini API (free tier; cascades across gemini models on quota).
# "mock" = clearly-marked deterministic fake AI (no key needed).
AI_PROVIDER="openrouter"

# OpenRouter — get a free key at https://openrouter.ai/keys
OPENROUTER_API_KEY=""
# Optional model overrides (comma-separated, tried in order). Sensible free-model
# defaults are built in; override only if you want specific models.
# OPENROUTER_TEXT_MODELS="nvidia/nemotron-3-super-120b-a12b:free,openai/gpt-oss-20b:free"
# OPENROUTER_VISION_MODELS="nvidia/nemotron-nano-12b-v2-vl:free,google/gemma-4-31b-it:free"

# Google Gemini API key — FREE from https://aistudio.google.com/apikey
# If empty, the app automatically falls back to the "mock" provider.
GEMINI_API_KEY=""

# Model selection (currently-available, free-tier friendly defaults).
# NOTE: gemini-2.5-flash / gemini-2.5-pro are now gated for NEW API keys (404
# "no longer available to new users"), and the *-pro models are quota-blocked on
# the free tier (429). gemini-flash-latest / gemini-3.5-flash have strong vision +
# reasoning and a workable free quota. Run `models.list()` to see what your key can use.
GEMINI_MODEL_PRO="gemini-3.5-flash"
# Lightweight passes (requirements/system/plan). Keep on a free-available model.
GEMINI_MODEL_FLASH="gemini-flash-latest"

# Where uploaded screenshots + generated sites + captures are stored on disk.
STORAGE_DIR="./storage"

# Public base URL of this app (used for absolute preview links).
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Set to "1" to skip Playwright at runtime (URL analysis will degrade gracefully).
DISABLE_PLAYWRIGHT="0"
