# ─────────────────────────────────────────────────────────────
# FORME environment configuration
# Copy this file to `.env` and fill in values.
# ─────────────────────────────────────────────────────────────

# Database (SQLite for local dev — Prisma). Postgres-compatible schema.
DATABASE_URL="file:./dev.db"

# AI is served by a MULTI-PROVIDER POOL to dodge free-tier rate limits: every
# configured text provider is rotated round-robin; on a rate-limit the request
# falls through to the next; Gemini handles vision + acts as a text fallback; Mock
# is the guaranteed last resort. A circuit breaker benches any failing key.
# "mock" forces the deterministic fake AI (no key needed).
AI_PROVIDER="openrouter"
# Global minimum gap (ms) between AI calls — keeps bursts under per-minute caps.
AI_MIN_GAP_MS="800"

# OpenRouter (OpenAI-compatible). Key from https://openrouter.ai/keys
# OPENROUTER_MODELS is a comma-separated list of free models to rotate through.
OPENROUTER_API_KEY=""
OPENROUTER_MODEL="poolside/laguna-m.1:free"
OPENROUTER_MODELS="poolside/laguna-m.1:free,nvidia/nemotron-3-ultra-550b-a55b:free"
OPENROUTER_VISION="0"

# Groq — very fast, generous free tier. Key from https://console.groq.com/keys
GROQ_API_KEY=""
GROQ_MODEL="llama-3.3-70b-versatile"

# Cerebras — key from https://cloud.cerebras.ai (needs active free credits).
CEREBRAS_API_KEY=""
CEREBRAS_MODEL="zai-glm-4.7"

# GitHub Models — a PAT with the "models: read" permission (github.com/settings/personal-access-tokens).
GITHUB_MODELS_KEY=""
GITHUB_MODEL="openai/gpt-4o-mini"

# Google Gemini API key — FREE from https://aistudio.google.com/apikey
# Vision-capable: used for all image analysis + as a text fallback.
GEMINI_API_KEY=""

# Model selection (free-tier friendly defaults).
# Most powerful vision+reasoning model that is usable on the FREE tier.
# NOTE: gemini-2.5-pro is quota-blocked on the free tier (429), so we default to
# gemini-2.5-flash which has strong vision + reasoning and a workable free quota.
GEMINI_MODEL_PRO="gemini-2.5-flash"
# Lightweight passes (requirements/system/plan). Keep on a free-available model.
GEMINI_MODEL_FLASH="gemini-2.5-flash"

# Where uploaded screenshots + generated sites + captures are stored on disk.
STORAGE_DIR="./storage"

# Public base URL of this app (used for absolute preview links).
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Set to "1" to skip Playwright at runtime (URL analysis will degrade gracefully).
DISABLE_PLAYWRIGHT="0"
